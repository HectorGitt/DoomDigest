{
	"manifest_version": 3,
	"name": "DoomDigest - Auto Article Summarizer",
	"version": "1.0",
	"description": "Automatically summarizes articles as you scroll using on-device AI and displays them in a sleek sidebar.",
	"permissions": ["sidePanel", "activeTab", "scripting", "storage"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js"
	},
	"side_panel": {
		"default_path": "sidebar.html"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	]
}
