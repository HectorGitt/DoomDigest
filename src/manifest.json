{
	"manifest_version": 3,
	"name": "DoomDigest",
	"icons": {
		"16": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	},
	"version": "1.0",
	"description": "Automatically summarizes articles as you scroll using on-device AI and displays them in a sleek sidebar.",
	"permissions": [
		"sidePanel",
		"activeTab",
		"scripting",
		"storage",
		"contextMenus",
		"downloads",
		"identity",
		"alarms",
		"notifications"
	],
	"oauth2": {
		"client_id": "CLIENT_ID.apps.googleusercontent.com",
		"scopes": ["https://www.googleapis.com/auth/drive.file"]
	},
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "DoomDigest - Open Sidebar"
	},
	"side_panel": {
		"default_path": "sidebar.html"
	},
	"options_page": "settings.html",
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_idle",
			"type": "module"
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"analytics.html",
				"analytics.js",
				"settings.css",
				"digest.html",
				"digest.css",
				"toast.js",
				"modal.js",
				"icon.png"
			],
			"matches": ["<all_urls>"]
		}
	]
}
