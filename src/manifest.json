{
	"manifest_version": 3,
	"name": "DoomDigest - Auto Article Summarizer",
	"version": "1.0",
	"description": "Automatically summarizes articles as you scroll using on-device AI and displays them in a sleek sidebar.",
	"permissions": [
		"sidePanel",
		"activeTab",
		"scripting",
		"storage",
		"contextMenus",
		"downloads"
	],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"side_panel": {
		"default_path": "sidebar.html"
	},
	"options_page": "settings.html",
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_idle",
			"type": "module"
		}
	]
}
